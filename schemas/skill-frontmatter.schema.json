{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:karaz:schema:skill-frontmatter:1.0",
  "title": "KARAZ skill frontmatter, schema 1.0",
  "description": "Shape of the YAML frontmatter at the top of a SKILL.md file. Vocabularies (type, status) live in registry/skills.yaml and are checked by the validator, not here. Unknown keys other than x_* are allowed by this schema; the validator reports them as warnings. Normative text: docs/SKILL-STANDARD.md section 13.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "status",
    "purpose",
    "scope",
    "non_goals",
    "inputs",
    "outputs",
    "dependencies",
    "platform_requirements",
    "safety",
    "verification"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "id": { "$ref": "#/$defs/skillId" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "type": { "$ref": "#/$defs/nonEmptyString" },
    "version": { "$ref": "#/$defs/semver" },
    "status": { "$ref": "#/$defs/nonEmptyString" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "scope": { "$ref": "#/$defs/nonEmptyStringList" },
    "non_goals": { "$ref": "#/$defs/nonEmptyStringList" },
    "inputs": { "$ref": "#/$defs/nonEmptyStringList" },
    "outputs": { "$ref": "#/$defs/nonEmptyStringList" },
    "dependencies": { "$ref": "#/$defs/stringList" },
    "platform_requirements": { "$ref": "#/$defs/stringList" },
    "safety": { "$ref": "#/$defs/nonEmptyStringList" },
    "verification": { "$ref": "#/$defs/nonEmptyStringList" }
  },
  "patternProperties": {
    "^x_": {}
  },
  "propertyNames": {
    "not": { "$ref": "#/$defs/reservedKey" }
  },
  "$defs": {
    "reservedKey": {
      "description": "Identity and activation words that no KARAZ file may use as a key (NR-4).",
      "enum": [
        "persona",
        "identity",
        "personality",
        "voice",
        "character",
        "installed",
        "activated",
        "auto_install",
        "auto_activate"
      ]
    },
    "schemaVersion": {
      "description": "MAJOR.MINOR as a quoted string. Optional in frontmatter; when absent it means 1.0.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "skillId": {
      "description": "Lowercase kebab-case identifier, at most 64 characters. Must equal the skill's directory name.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "semver": {
      "description": "Semantic Versioning 2.0.0. Quote the value in YAML so that it is read as a string.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stringList": {
      "description": "A list of non-empty strings. An empty list is allowed and declares 'none'.",
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "nonEmptyStringList": {
      "description": "A list of non-empty strings with at least one item.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  }
}
